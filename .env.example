# Copy to .env and fill in. Everything has a working default for a local run.

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low              # low keeps demo latency down; medium/high for richer answers
# DEMO_AI_DISABLED=true           # force the keyword-rule fallbacks

# --- Temporal: local dev server (default) ------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Temporal Cloud with an API key ------------------------------------------
# TEMPORAL_ADDRESS=us-east-1.aws.api.temporal.io:7233
# TEMPORAL_NAMESPACE=your-namespace.a1b2c
# TEMPORAL_API_KEY=

# --- Temporal Cloud or self-hosted with mTLS ---------------------------------
# TEMPORAL_ADDRESS=your-namespace.a1b2c.tmprl.cloud:7233
# TEMPORAL_TLS_CERT=/path/to/client.pem
# TEMPORAL_TLS_KEY=/path/to/client.key
# TEMPORAL_TLS_CA=                # self-hosted with a private CA

# TEMPORAL_UI_URL=                # override where the jump links point

# --- Demo ----------------------------------------------------------------------
DEMO_ORG=Example Bank            # the fictional company in Claude's prompts
DEMO_BRAND=Domainos
DEMO_START_WORKERS=core:2,onprem:2
DEMO_PORT=8800
# DEMO_MANAGE_WORKERS=false       # run workers yourself (e.g. in Kubernetes) instead of from the UI
# WORKER_MAX_ACTIVITIES=3         # lower it to make "add a worker" visibly drain the backlog

# --- Real connectors (see config/connectors.yaml) -----------------------------
# CONNECTORS_MODE=real            # flip everything at once, or per system:
# CONNECTOR_MODE_AWS_ORGS=real
# AWS_PROFILE=
# SN_INSTANCE_URL= SN_USER= SN_PASSWORD=
# OKTA_ORG_URL= OKTA_API_TOKEN= OKTA_AWS_APP_ID=
# SPLUNK_MGMT_URL= SPLUNK_USER= SPLUNK_PASSWORD=
# INFOBLOX_HOST= INFOBLOX_USER= INFOBLOX_PASSWORD=
# PANORAMA_HOST= PANORAMA_API_KEY=
